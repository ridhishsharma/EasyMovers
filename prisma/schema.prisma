model Payment {
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Identity
  ///    * --------------------------------------------------------------------------
  id                            String                  @id @default(cuid())
  paymentNumber                 String                  @unique
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Marketplace relations
  ///    * --------------------------------------------------------------------------
  bookingId                     String                  @unique
  quotationId                   String?
  userId                        String?
  vendorId                      String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Legacy Payment value
  ///    * KEEP during transition.
  ///    * Existing Payment records and existing code may still depend on amount.
  ///    * New aggregate code should use totalAmount / paidAmount / balanceAmount.
  ///    * --------------------------------------------------------------------------
  amount                        Decimal                 @db.Decimal(12, 2)
  currency                      String                  @default("INR")
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Legacy classification
  ///    * paymentMethod and paymentType are now optional because an aggregate can
  ///    * exist before a customer chooses a method or executes a transaction.
  ///    * The normalized PaymentTransaction records become the authoritative source
  ///    * for transaction-specific method and purpose.
  ///    * --------------------------------------------------------------------------
  paymentMethod                 PaymentMethod?
  paymentType                   PaymentType?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Aggregate workflow
  ///    * --------------------------------------------------------------------------
  paymentStatus                 PaymentStatus           @default(PENDING)
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Legacy transaction/gateway fields
  ///    * KEEP temporarily for backward compatibility.
  ///    * New transaction attempts should be stored in PaymentTransaction.
  ///    * --------------------------------------------------------------------------
  transactionId                 String?
  gatewayTransactionId          String?
  gatewayOrderId                String?
  gatewayPaymentId              String?
  gatewaySignature              String?
  bankReference                 String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Operational notes
  ///    * --------------------------------------------------------------------------
  remarks                       String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Legacy/operational timestamps
  ///    * --------------------------------------------------------------------------
  paidAt                        DateTime?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Refund summary
  ///    * Legacy refund fields remain alongside the new summary.
  ///    * --------------------------------------------------------------------------
  refundAmount                  Decimal?                @db.Decimal(12, 2)
  refundReason                  String?
  refundedAt                    DateTime?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Flexible metadata / audit
  ///    * --------------------------------------------------------------------------
  metadata                      Json?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Audit timestamps
  ///    * --------------------------------------------------------------------------
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  advanceAmount                 Decimal?                @db.Decimal(12, 2)
  auditJson                     Json?
  balanceAmount                 Decimal                 @default(0) @db.Decimal(12, 2)
  /// *
  ///    * Snapshot/reference to the commercial calculation that produced the
  ///    * customer payable amount.
  ///    * Expected values may include:
  ///    * quotationId
  ///    * quotationNumber
  ///    * customerPayableAmount
  ///    * vendorQuotedAmount
  ///    * platformMarkupAmount
  ///    * platformCommissionAmount
  ///    * currency
  commercialReference           Json?
  internalRemarks               String?
  /// *
  ///    * Fast pointer only.
  ///    * The actual transaction remains in PaymentTransaction.
  latestSuccessfulTransactionId String?
  paidAmount                    Decimal                 @default(0) @db.Decimal(12, 2)
  /// *
  ///    * Optional persisted copy of the aggregate payable summary.
  ///    * Numeric columns above remain searchable/reportable source fields.
  payableJson                   Json?
  paymentPending                Decimal                 @default(0) @db.Decimal(12, 2)
  /// *
  ///    * New canonical Payment-domain reference.
  ///    * Kept optional during the migration phase so existing Payment rows do not
  ///    * prevent migration. New PaymentService operations will always populate it.
  ///    * After old records are backfilled, this can become required.
  referenceId                   String?                 @unique
  refundPendingAmount           Decimal                 @default(0) @db.Decimal(12, 2)
  refundSummaryJson             Json?
  source                        PaymentSource           @default(API)
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Canonical aggregate financial summary
  ///    * --------------------------------------------------------------------------
  totalAmount                   Decimal                 @default(0) @db.Decimal(12, 2)
  booking                       Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quotation                     Quotation?              @relation(fields: [quotationId], references: [id])
  user                          User?                   @relation(fields: [userId], references: [id])
  vendor                        Vendor?                 @relation(fields: [vendorId], references: [id])
  gatewayOrders                 PaymentGatewayOrder[]
  reconciliations               PaymentReconciliation[]
  bookingSync                   PaymentBookingSync?
  transactions                  PaymentTransaction[]
  webhooks                      PaymentWebhook[]

  @@index([paymentNumber])
  @@index([referenceId])
  @@index([quotationId])
  @@index([userId])
  @@index([vendorId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([source])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([createdAt])
}

model PaymentTransaction {
  id                 String                   @id @default(cuid())
  paymentId          String
  transactionType    PaymentTransactionType
  purpose            PaymentPurpose?
  amount             Decimal                  @db.Decimal(12, 2)
  currency           String                   @default("INR")
  status             PaymentTransactionStatus @default(INITIATED)
  method             PaymentMethod?
  provider           PaymentProvider          @default(OTHER)
  gatewayOrderId     String?
  gatewayPaymentId   String?                  @unique
  gatewayReferenceId String?
