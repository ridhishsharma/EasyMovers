generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                   String      @id @default(cuid())
  referenceId          String      @unique
  name                 String
  mobile               String
  email                String?
  pickupCity           String?
  destinationCity      String?
  shiftingType         String?
  pickupFloor          String?
  liftAvailable        String?
  packingRequired      String?
  notes                String?
  createdAt            DateTime    @default(now())
  bikeCount            Int?
  carCount             Int?
  destinationDigipin   String?
  destinationInput     String?
  destinationLatitude  Decimal?    @db.Decimal(10, 7)
  destinationLongitude Decimal?    @db.Decimal(10, 7)
  destinationPincode   String?
  destinationState     String?
  houseType            String?
  lastUpdatedAt        DateTime    @updatedAt
  officeSize           String?
  pickupDigipin        String?
  pickupLatitude       Decimal?    @db.Decimal(10, 7)
  pickupLongitude      Decimal?    @db.Decimal(10, 7)
  pickupPincode        String?
  pickupState          String?
  plantsIncluded       Boolean?
  shiftingDate         String?
  source               LeadSource  @default(WEBSITE)
  userId               String?
  vehicleCount         Int?
  vehicleType          String?
  status               LeadStatus  @default(NEW)
  bookings             Booking[]
  inventory            Inventory?
  user                 User?       @relation(fields: [userId], references: [id])
  quotations           Quotation[]

  @@index([referenceId])
  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([source])
  @@index([pickupCity])
  @@index([destinationCity])
  @@index([pickupPincode])
  @@index([destinationPincode])
  @@index([pickupDigipin])
  @@index([destinationDigipin])
  @@index([userId])
  @@index([createdAt])
}

model Vendor {
  id                     String              @id @default(cuid())
  companyName            String
  ownerName              String
  gstNumber              String?
  serviceCities          String
  householdService       Boolean             @default(false)
  officeService          Boolean             @default(false)
  vehicleService         Boolean             @default(false)
  experienceYears        Int?
  rating                 Float               @default(0)
  reviewCount            Int                 @default(0)
  status                 String              @default("PENDING")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  address                String?
  city                   String?
  companyLogo            String?
  completedMoves         Int                 @default(0)
  coordinatorEmail       String?
  coordinatorMobile      String?
  coordinatorName        String?
  insuranceAvailable     Boolean             @default(false)
  ownerEmail             String?
  ownerMobile            String              @unique
  panNumber              String?
  pincode                String?
  quotationContactEmail  String?
  quotationContactMobile String?
  quotationContactName   String?
  remarks                String?
  state                  String?
  totalLabours           Int?
  totalVehicles          Int?
  vendorCode             String              @unique
  website                String?
  assignedBookings       Booking[]           @relation("AssignedVendorBookings")
  payments               Payment[]
  quotations             Quotation[]
  User                   User[]
  bankAccounts           VendorBankAccount[]
  documents              VendorDocument[]
  ratingSummary          VendorRating?
  reviews                VendorReview[]
  vehicles               VendorVehicle[]
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  referenceId        String          @unique
  leadId             String
  bookingId          String
  vendorId           String
  userId             String?
  transportationCost Decimal         @default(0) @db.Decimal(12, 2)
  packingCost        Decimal         @default(0) @db.Decimal(12, 2)
  unpackingCost      Decimal         @default(0) @db.Decimal(12, 2)
  labourCost         Decimal         @default(0) @db.Decimal(12, 2)
  insuranceCost      Decimal         @default(0) @db.Decimal(12, 2)
  otherCost          Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @db.Decimal(12, 2)
  currency           String          @default("INR")
  pickupDate         DateTime?
  deliveryDate       DateTime?
  transitDays        Int?
  status             QuotationStatus @default(SUBMITTED)
  validUntil         DateTime?
  pricingBreakdown   Json?
  termsJson          Json?
  inclusionsJson     Json?
  exclusionsJson     Json?
  remarks            String?
  internalRemarks    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  selectedForBooking Booking?        @relation("SelectedBookingQuotation")
  payments           Payment[]
  booking            Booking         @relation("BookingQuotations", fields: [bookingId], references: [id], onDelete: Cascade)
  lead               Lead            @relation(fields: [leadId], references: [id])
  user               User?           @relation(fields: [userId], references: [id])
  vendor             Vendor          @relation(fields: [vendorId], references: [id])

  @@index([quotationNumber])
  @@index([referenceId])
  @@index([leadId])
  @@index([bookingId])
  @@index([vendorId])
  @@index([userId])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
}

model InventoryItem {
  id              String    @id @default(cuid())
  inventoryId     String
  category        String
  itemName        String
  quantity        Int       @default(1)
  fragile         Boolean   @default(false)
  requiresPacking Boolean   @default(true)
  remarks         String?
  createdAt       DateTime  @default(now())
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model InventoryPhoto {
  id          String    @id @default(cuid())
  inventoryId String
  imageUrl    String
  roomType    String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model Inventory {
  id                         String           @id @default(cuid())
  referenceId                String           @unique
  leadId                     String           @unique
  status                     String           @default("DRAFT")
  completionPercentage       Int              @default(0)
  moveReadinessScore         Int              @default(0)
  createdBy                  String?
  remarks                    String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  additionalServices         Json?
  packingType                String?          @default("STANDARD")
  specialHandling            Json?
  preMoveServices            Json?
  callbackRequested          Boolean          @default(false)
  callbackSlot               String?
  destinationFloor           Int?
  destinationLiftAvailable   Boolean          @default(false)
  destinationParkingDistance String?
  destinationPropertyType    String?
  destinationSame            Boolean          @default(true)
  dismantlingServices        Json?
  installationServices       Json?
  packingServices            Json?
  photoInventoryRequested    Boolean          @default(false)
  photoInventoryUrls         Json?
  pickupFloor                Int?
  pickupLiftAvailable        Boolean          @default(false)
  pickupParkingDistance      String?
  pickupPropertyType         String?
  postMoveServices           Json?
  surveyType                 String?          @default("MANUAL")
  lead                       Lead             @relation(fields: [leadId], references: [id])
  items                      InventoryItem[]
  photos                     InventoryPhoto[]
}

model DestinationDetails {
  id                   String   @id @default(cuid())
  referenceId          String   @unique
  propertyType         String?
  floorNumber          Int?
  liftAvailable        Boolean?
  parkingDistance      String?
  installationServices Json?
  additionalServices   Json?
  specialInstructions  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Booking {
  id                   String            @id @default(cuid())
  bookingNumber        String            @unique
  leadId               String
  leadReferenceId      String
  userId               String?
  customerName         String
  customerMobile       String
  customerEmail        String?
  serviceType          String
  moveType             String
  moveDate             DateTime
  deliveryDate         DateTime?
  pickupCity           String
  pickupState          String
  pickupPincode        String
  pickupDigipin        String?
  pickupLatitude       Decimal?          @db.Decimal(10, 7)
  pickupLongitude      Decimal?          @db.Decimal(10, 7)
  dropCity             String
  dropState            String
  dropPincode          String
  dropDigipin          String?
  dropLatitude         Decimal?          @db.Decimal(10, 7)
  dropLongitude        Decimal?          @db.Decimal(10, 7)
  pickupAddress        String
  dropAddress          String
  contactJson          Json
  pickupAddressJson    Json
  dropAddressJson      Json
  scheduleJson         Json
  inventoryJson        Json
  inventorySummaryJson Json
  servicesJson         Json
  requirementsJson     Json?
  aiAnalysisJson       Json?
  vendorId             String?
  vendorName           String?
  assignedVendorCode   String?
  vendorJson           Json?
  selectedQuotationId  String?           @unique
  quotationJson        Json?
  paymentJson          Json?
  trackingJson         Json?
  timelineJson         Json
  auditJson            Json
  totalAmount          Decimal           @default(0) @db.Decimal(12, 2)
  currency             String            @default("INR")
  bookingStatus        String            @default("DRAFT")
  paymentStatus        String            @default("PENDING")
  trackingStatus       TrackingStatus    @default(NOT_STARTED)
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  lead                 Lead              @relation(fields: [leadId], references: [id])
  selectedQuotation    Quotation?        @relation("SelectedBookingQuotation", fields: [selectedQuotationId], references: [id])
  user                 User?             @relation(fields: [userId], references: [id])
  assignedVendor       Vendor?           @relation("AssignedVendorBookings", fields: [vendorId], references: [id])
  bookingTrackings     BookingTracking[]
  payments             Payment[]
  quotations           Quotation[]       @relation("BookingQuotations")

  @@index([bookingNumber])
  @@index([leadId])
  @@index([leadReferenceId])
  @@index([userId])
  @@index([vendorId])
  @@index([selectedQuotationId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([trackingStatus])
  @@index([customerMobile])
  @@index([moveDate])
  @@index([serviceType])
  @@index([moveType])
  @@index([pickupCity])
  @@index([pickupState])
  @@index([pickupPincode])
  @@index([pickupDigipin])
  @@index([dropCity])
  @@index([dropState])
  @@index([dropPincode])
  @@index([dropDigipin])
  @@index([createdAt])
}

model CallbackRequest {
  id            String   @id @default(cuid())
  fullName      String
  mobile        String
  email         String?
  city          String?
  serviceType   String?
  preferredTime String?
  message       String?
  status        String   @default("Pending")
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String?
  User          User?    @relation(fields: [userId], references: [id])

  @@index([mobile])
  @@index([status])
}

model User {
  id                     String                  @id @default(cuid())
  email                  String?                 @unique
  mobile                 String                  @unique
  passwordHash           String
  fullName               String
  role                   UserRole                @default(CUSTOMER)
  avatar                 String?
  isActive               Boolean                 @default(true)
  emailVerified          Boolean                 @default(false)
  mobileVerified         Boolean                 @default(false)
  lastLogin              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  vendorId               String?
  bookings               Booking[]
  callbackRequests       CallbackRequest[]
  Corporate              Corporate?
  Customer               Customer?
  customerDocuments      CustomerDocument[]
  Franchise              Franchise?
  leads                  Lead[]
  Notification           Notification[]
  notificationPreference NotificationPreference?
  payments               Payment[]
  quotations             Quotation[]
  vendor                 Vendor?                 @relation(fields: [vendorId], references: [id])

  @@index([mobile])
  @@index([email])
  @@index([role])
}

model Customer {
  id              String    @id @default(cuid())
  userId          String    @unique
  alternateMobile String?
  dateOfBirth     DateTime?
  gender          String?
  companyName     String?
  gstNumber       String?
  panNumber       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
}

model Corporate {
  id                 String    @id @default(cuid())
  userId             String    @unique
  companyName        String
  legalName          String?
  registrationNumber String?
  gstNumber          String?
  panNumber          String?
  contactPerson      String
  designation        String?
  alternateMobile    String?
  landline           String?
  website            String?
  email              String?
  industry           String?
  employeeStrength   Int?
  annualRelocations  Int?
  billingAddress     String?
  city               String?
  state              String?
  pincode            String?
  country            String?   @default("India")
  accountManager     String?
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  creditLimit        Decimal?  @db.Decimal(12, 2)
  paymentTerms       Int?      @default(30)
  preferredVendorId  String?
  isActive           Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
  @@index([gstNumber])
  @@index([city])
  @@index([state])
}

model Franchise {
  id                String    @id @default(cuid())
  userId            String    @unique
  franchiseCode     String    @unique
  franchiseName     String
  ownerName         String
  businessName      String?
  gstNumber         String?
  panNumber         String?
  aadhaarNumber     String?
  email             String?
  mobile            String
  alternateMobile   String?
  landline          String?
  website           String?
  address           String
  city              String
  district          String?
  state             String
  pincode           String
  country           String    @default("India")
  operatingArea     String?
  territory         String?
  latitude          Float?
  longitude         Float?
  joiningDate       DateTime?
  agreementExpiry   DateTime?
  commissionPercent Decimal?  @db.Decimal(5, 2)
  securityDeposit   Decimal?  @db.Decimal(12, 2)
  monthlyTarget     Int?
  yearlyTarget      Int?
  achievedBookings  Int       @default(0)
  rating            Float?    @default(0)
  totalRevenue      Decimal?  @db.Decimal(14, 2)
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  branchName        String?
  isActive          Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([franchiseCode])
  @@index([city])
  @@index([state])
  @@index([mobile])
}

model Notification {
  id            String              @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType
  channel       NotificationChannel @default(IN_APP)
  referenceId   String?
  referenceType String?
  actionUrl     String?
  icon          String?
  image         String?
  priority      Int                 @default(1)
  isRead        Boolean             @default(false)
  readAt        DateTime?
  sent          Boolean             @default(false)
  sentAt        DateTime?
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model VendorDocument {
  id                 String             @id @default(cuid())
  vendorId           String
  documentType       VendorDocumentType
  documentNumber     String?
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  issuedBy           String?
  issuedDate         DateTime?
  expiryDate         DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  remarks            String?
  isMandatory        Boolean            @default(false)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  vendor             Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([documentType])
  @@index([verificationStatus])
}

model VendorRating {
  id                  String    @id @default(cuid())
  vendorId            String    @unique
  averageRating       Decimal   @default(0.00) @db.Decimal(3, 2)
  totalReviews        Int       @default(0)
  rating5             Int       @default(0)
  rating4             Int       @default(0)
  rating3             Int       @default(0)
  rating2             Int       @default(0)
  rating1             Int       @default(0)
  onTimeDeliveryScore Decimal   @default(0.00) @db.Decimal(5, 2)
  packingQualityScore Decimal   @default(0.00) @db.Decimal(5, 2)
  staffBehaviourScore Decimal   @default(0.00) @db.Decimal(5, 2)
  communicationScore  Decimal   @default(0.00) @db.Decimal(5, 2)
  pricingScore        Decimal   @default(0.00) @db.Decimal(5, 2)
  complaintCount      Int       @default(0)
  resolvedComplaints  Int       @default(0)
  cancellationCount   Int       @default(0)
  completedBookings   Int       @default(0)
  repeatCustomers     Int       @default(0)
  recommendationRate  Decimal   @default(0.00) @db.Decimal(5, 2)
  lastReviewedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  vendor              Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([averageRating])
  @@index([completedBookings])
}

model VendorReview {
  id                  String             @id @default(cuid())
  vendorId            String
  customerId          String?
  bookingId           String?
  quotationId         String?
  customerName        String
  customerMobile      String?
  customerEmail       String?
  overallRating       Decimal            @db.Decimal(3, 2)
  packingRating       Decimal?           @db.Decimal(3, 2)
  deliveryRating      Decimal?           @db.Decimal(3, 2)
  behaviourRating     Decimal?           @db.Decimal(3, 2)
  communicationRating Decimal?           @db.Decimal(3, 2)
  pricingRating       Decimal?           @db.Decimal(3, 2)
  title               String?
  review              String
  recommendation      RecommendationType @default(YES)
  verifiedBooking     Boolean            @default(false)
  helpfulCount        Int                @default(0)
  reportedCount       Int                @default(0)
  status              ReviewStatus       @default(PENDING)
  adminRemarks        String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  vendor              Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([bookingId])
  @@index([quotationId])
  @@index([status])
  @@index([overallRating])
}

model Payment {
  id                   String        @id @default(cuid())
  paymentNumber        String        @unique
  bookingId            String
  quotationId          String?
  userId               String?
  vendorId             String?
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("INR")
  paymentMethod        PaymentMethod
  paymentType          PaymentType
  paymentStatus        PaymentStatus @default(PENDING)
  transactionId        String?
  gatewayTransactionId String?
  gatewayOrderId       String?
  gatewayPaymentId     String?
  gatewaySignature     String?
  bankReference        String?
  remarks              String?
  paidAt               DateTime?
  refundAmount         Decimal?      @db.Decimal(12, 2)
  refundReason         String?
  refundedAt           DateTime?
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quotation            Quotation?    @relation(fields: [quotationId], references: [id])
  user                 User?         @relation(fields: [userId], references: [id])
  vendor               Vendor?       @relation(fields: [vendorId], references: [id])

  @@index([paymentNumber])
  @@index([bookingId])
  @@index([quotationId])
  @@index([userId])
  @@index([vendorId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  bookingId      String?
  quotationId    String?
  paymentId      String?
  customerId     String?
  vendorId       String?
  invoiceType    InvoiceType
  invoiceStatus  InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime
  dueDate        DateTime?
  taxableAmount  Decimal       @db.Decimal(12, 2)
  cgst           Decimal       @default(0) @db.Decimal(12, 2)
  sgst           Decimal       @default(0) @db.Decimal(12, 2)
  igst           Decimal       @default(0) @db.Decimal(12, 2)
  cess           Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  billingName    String
  billingAddress String
  billingGST     String?
  placeOfSupply  String?
  pdfUrl         String?
  remarks        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookingId])
  @@index([quotationId])
  @@index([paymentId])
  @@index([invoiceStatus])
  @@index([invoiceDate])
}

model BookingTracking {
  id               String         @id @default(cuid())
  bookingId        String
  trackingStatus   TrackingStatus
  location         String?
  latitude         Float?
  longitude        Float?
  remarks          String?
  updatedBy        String?
  updatedByRole    String?
  estimatedArrival DateTime?
  actualArrival    DateTime?
  photoUrl         String?
  signatureUrl     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([trackingStatus])
  @@index([createdAt])
}

model OTP {
  id          String     @id @default(cuid())
  mobile      String?
  email       String?
  otpCode     String
  purpose     OTPPurpose
  userId      String?
  bookingId   String?
  quotationId String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  verified    Boolean    @default(false)
  expiresAt   DateTime
  verifiedAt  DateTime?
  ipAddress   String?
  deviceInfo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
}

model AuditLog {
  id              String      @id @default(cuid())
  userId          String?
  action          AuditAction
  entity          AuditEntity
  entityId        String?
  description     String
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  deviceInfo      String?
  browser         String?
  operatingSystem String?
  requestMethod   String?
  requestUrl      String?
  responseCode    Int?
  success         Boolean     @default(true)
  remarks         String?
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

model VendorVehicle {
  id                  String           @id @default(cuid())
  vendorId            String
  registrationNumber  String           @unique
  vehicleType         VehicleType
  ownership           VehicleOwnership @default(OWNED)
  status              VehicleStatus    @default(AVAILABLE)
  brand               String?
  model               String?
  manufacturingYear   Int?
  color               String?
  fuelType            String?
  carryingCapacityKg  Int?
  volumeCapacityCft   Int?
  lengthFt            Float?
  widthFt             Float?
  heightFt            Float?
  driverName          String?
  driverMobile        String?
  driverLicenseNumber String?
  insuranceNumber     String?
  insuranceExpiry     DateTime?
  permitNumber        String?
  permitExpiry        DateTime?
  fitnessExpiry       DateTime?
  pollutionExpiry     DateTime?
  gpsInstalled        Boolean          @default(false)
  gpsDeviceId         String?
  currentCity         String?
  currentLatitude     Float?
  currentLongitude    Float?
  remarks             String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  vendor              Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vehicleType])
  @@index([status])
  @@index([registrationNumber])
}

model VendorBankAccount {
  id                 String          @id @default(cuid())
  vendorId           String
  accountHolderName  String
  bankName           String
  branchName         String?
  accountNumber      String
  ifscCode           String
  swiftCode          String?
  upiId              String?
  accountType        BankAccountType
  cancelledChequeUrl String?
  verified           Boolean         @default(false)
  verifiedBy         String?
  verifiedAt         DateTime?
  isPrimary          Boolean         @default(false)
  isActive           Boolean         @default(true)
  remarks            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  vendor             Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([ifscCode])
  @@index([accountNumber])
}

model NotificationPreference {
  id                    String                @id @default(cuid())
  userId                String                @unique
  emailEnabled          Boolean               @default(true)
  smsEnabled            Boolean               @default(true)
  pushEnabled           Boolean               @default(true)
  inAppEnabled          Boolean               @default(true)
  bookingUpdates        Boolean               @default(true)
  quotationUpdates      Boolean               @default(true)
  paymentUpdates        Boolean               @default(true)
  vendorUpdates         Boolean               @default(true)
  promotionalMessages   Boolean               @default(false)
  newsletter            Boolean               @default(false)
  reminderNotifications Boolean               @default(true)
  frequency             NotificationFrequency @default(IMMEDIATE)
  quietHoursEnabled     Boolean               @default(false)
  quietHoursStart       String?
  quietHoursEnd         String?
  preferredLanguage     String                @default("en")
  timezone              String                @default("Asia/Kolkata")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerDocument {
  id                 String               @id @default(cuid())
  userId             String
  documentType       CustomerDocumentType
  documentNumber     String?
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  issuedBy           String?
  issuedDate         DateTime?
  expiryDate         DateTime?
  verificationStatus VerificationStatus   @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  remarks            String?
  isMandatory        Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
  @@index([verificationStatus])
}

