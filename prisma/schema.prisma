  failureReason      String?
  failureMessage     String?
  providerErrorCode  String?
  initiatedAt        DateTime                 @default(now())
  authorizedAt       DateTime?
  capturedAt         DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  remarks            String?
  recordedByType     PaymentActorType?
  recordedById       String?
  recordedByName     String?
  metadata           Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  payment            Payment                  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([transactionType])
  @@index([purpose])
  @@index([status])
  @@index([method])
  @@index([provider])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([bankReference])
  @@index([initiatedAt])
  @@index([createdAt])
}

model PaymentGatewayOrder {
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Identity
  ///    * --------------------------------------------------------------------------
  id               String                    @id @default(cuid())
  paymentId        String
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Gateway identity
  ///    * --------------------------------------------------------------------------
  provider         PaymentProvider
  /// *
  ///    * Provider-side order ID.
  ///    * A gateway order must never be processed as two separate orders.
  gatewayOrderId   String                    @unique
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Financial information
  ///    * --------------------------------------------------------------------------
  amount           Decimal                   @db.Decimal(12, 2)
  currency         String                    @default("INR")
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Lifecycle
  ///    * --------------------------------------------------------------------------
  status           PaymentGatewayOrderStatus @default(CREATED)
  receiptReference String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Provider-safe metadata
  ///    * --------------------------------------------------------------------------
  metadata         Json?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Audit
  ///    * --------------------------------------------------------------------------
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  payment          Payment                   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider])
  @@index([status])
  @@index([receiptReference])
  @@index([createdAt])
}

model PaymentWebhook {
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Internal identity
  ///    * --------------------------------------------------------------------------
  id               String          @id @default(cuid())
  /// *
  ///    * EasyMovers webhook processing identity.
  webhookId        String          @unique
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Provider event identity
  ///    * --------------------------------------------------------------------------
  provider         PaymentProvider
  /// *
  ///    * Normalized or provider event name.
  ///    * Kept as String intentionally because providers may introduce new event
  ///    * types without requiring a database enum migration.
  eventType        String
  providerEventId  String?
  /// *
  ///    * Optional payload fingerprint.
  ///    * This can be used for additional duplicate protection where a gateway does
  ///    * not provide a reliable providerEventId.
  payloadHash      String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Gateway references
  ///    * --------------------------------------------------------------------------
  gatewayOrderId   String?
  gatewayPaymentId String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Processing state
  ///    * --------------------------------------------------------------------------
  processed        Boolean         @default(false)
  duplicate        Boolean         @default(false)
  receivedAt       DateTime        @default(now())
  processedAt      DateTime?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Result references
  ///    * transactionId remains an identifier rather than a Prisma relation for now.
  ///    * This avoids coupling webhook persistence to transaction deletion/history.
  ///    * --------------------------------------------------------------------------
  paymentId        String?
  transactionId    String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Failure information
  ///    * --------------------------------------------------------------------------
  errorCode        String?
  errorMessage     String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Audit
  ///    * --------------------------------------------------------------------------
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  payment          Payment?        @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([provider])
  @@index([eventType])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([providerEventId])
  @@index([payloadHash])
  @@index([processed])
  @@index([receivedAt])
}

model PaymentReconciliation {
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Identity
  ///    * --------------------------------------------------------------------------
  id                      String          @id @default(cuid())
  reconciliationId        String          @unique
  paymentId               String
  provider                PaymentProvider
  expectedCollectedAmount Decimal         @db.Decimal(12, 2)
  expectedRefundedAmount  Decimal         @default(0) @db.Decimal(12, 2)
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Values observed from gateway/bank
  ///    * --------------------------------------------------------------------------
  observedCollectedAmount Decimal         @db.Decimal(12, 2)
  observedRefundedAmount  Decimal         @default(0) @db.Decimal(12, 2)
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Currency
  ///    * --------------------------------------------------------------------------
  currency                String          @default("INR")
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Result
  ///    * --------------------------------------------------------------------------
  reconciled              Boolean         @default(false)
  /// *
  ///    * Normalized differences such as:
  ///    * [
  ///    * {
  ///    * "field": "collectedAmount",
  ///    * "expected": 23010,
  ///    * "observed": 22510,
  ///    * "difference": -500
  ///    * }
  ///    * ]
  differences             Json
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * External reference
  ///    * --------------------------------------------------------------------------
  providerReference       String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Reconciliation timestamps/audit
  ///    * --------------------------------------------------------------------------
  observedAt              DateTime
  reconciledAt            DateTime        @default(now())
  reconciledBy            String?
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Record audit
  ///    * --------------------------------------------------------------------------
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  expectedBalanceAmount   Decimal?        @db.Decimal(12, 2)
  /// *
  ///    * --------------------------------------------------------------------------
  ///    * Expected EasyMovers values
  ///    * --------------------------------------------------------------------------
  ///    * These fields preserve the Payment financial snapshot exactly as it existed
  ///    * when reconciliation was performed.
  ///    * expectedTotalAmount and expectedBalanceAmount are nullable so existing
  ///    * reconciliation rows can be migrated safely without inventing historical
  ///    * values. All new reconciliation records must populate them.
  ///    * --------------------------------------------------------------------------
  expectedTotalAmount     Decimal?        @db.Decimal(12, 2)
  payment                 Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider])
  @@index([reconciled])
  @@index([providerReference])
  @@index([observedAt])
  @@index([reconciledAt])
  @@index([createdAt])
}

model PaymentBookingSync {
  /**
   * Identity
   */
  id String @id @default(cuid())

  /**
   * One current synchronization state per Payment.
   */
  paymentId String @unique

  bookingId String

  /**
   * Current delivery state.
   */
  status PaymentBookingSyncStatus @default(PENDING)

  /**
   * Payment.updatedAt captured when this synchronization projection was
   * created. It prevents an older synchronization attempt from marking a
   * newer Payment projection as synchronized.
   */
  paymentUpdatedAt DateTime

  /**
   * Latest authoritative Payment financial projection.
   */
  paymentSnapshotJson Json

  /**
   * Latest Booking projection observed after a synchronization attempt.
   */
  bookingSnapshotJson Json?

  /**
   * Retry state.
   */
  attemptCount Int @default(0)

  lastAttemptAt DateTime?

  nextRetryAt DateTime?

  synchronizedAt DateTime?

  /**
   * Sanitized failure information only.
   * Never persist raw Prisma, Booking repository or stack-trace objects.
   */
  lastErrorCode String?

  lastErrorMessage String?

  /**
   * Audit actor that requested or last attempted synchronization.
   */
  requestedBy String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * Relations
   */
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([lastAttemptAt])
  @@index([paymentUpdatedAt])
  @@index([createdAt])
}

