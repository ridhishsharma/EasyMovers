generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                   String      @id @default(cuid())
  referenceId          String      @unique
  name                 String
  mobile               String
  email                String?
  pickupCity           String?
  destinationCity      String?
  shiftingType         String?
  pickupFloor          String?
  liftAvailable        String?
  packingRequired      String?
  notes                String?
  createdAt            DateTime    @default(now())
  bikeCount            Int?
  carCount             Int?
  destinationDigipin   String?
  destinationInput     String?
  destinationLatitude  Decimal?    @db.Decimal(10, 7)
  destinationLongitude Decimal?    @db.Decimal(10, 7)
  destinationPincode   String?
  destinationState     String?
  houseType            String?
  lastUpdatedAt        DateTime    @updatedAt
  officeSize           String?
  pickupDigipin        String?
  pickupLatitude       Decimal?    @db.Decimal(10, 7)
  pickupLongitude      Decimal?    @db.Decimal(10, 7)
  pickupPincode        String?
  pickupState          String?
  plantsIncluded       Boolean?
  shiftingDate         String?
  source               LeadSource  @default(WEBSITE)
  userId               String?
  vehicleCount         Int?
  vehicleType          String?
  status               LeadStatus  @default(NEW)
  bookings             Booking[]
  inventory            Inventory?
  user                 User?       @relation(fields: [userId], references: [id])
  quotations           Quotation[]

  @@index([referenceId])
  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([source])
  @@index([pickupCity])
  @@index([destinationCity])
  @@index([pickupPincode])
  @@index([destinationPincode])
  @@index([pickupDigipin])
  @@index([destinationDigipin])
  @@index([userId])
  @@index([createdAt])
}

model Vendor {
  id                     String                  @id @default(cuid())
  companyName            String
  ownerName              String
  businessType           VendorBusinessType      @default(UNSPECIFIED)
  engagementMode         VendorEngagementMode    @default(QUOTATION)
  gstNumber              String?
  serviceCities          String
  householdService       Boolean                 @default(false)
  officeService          Boolean                 @default(false)
  vehicleService         Boolean                 @default(false)
  experienceYears        Int?
  rating                 Float                   @default(0)
  reviewCount            Int                     @default(0)
  status                 String                  @default("PENDING")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  address                String?
  city                   String?
  companyLogo            String?
  completedMoves         Int                     @default(0)
  coordinatorEmail       String?
  coordinatorMobile      String?
  coordinatorName        String?
  insuranceAvailable     Boolean                 @default(false)
  ownerEmail             String?
  ownerMobile            String                  @unique
  panNumber              String?
  pincode                String?
  quotationContactEmail  String?
  quotationContactMobile String?
  quotationContactName   String?
  remarks                String?
  state                  String?
  totalLabours           Int?
  totalVehicles          Int?
  vendorCode             String                  @unique
  website                String?
  assignedBookings       Booking[]               @relation("AssignedVendorBookings")
  payments               Payment[]
  quotations             Quotation[]
  User                   User[]
  bankAccounts           VendorBankAccount[]
  documents              VendorDocument[]
  serviceAreas           VendorServiceArea[]
  serviceOfferings       VendorServiceOffering[]
  pricingRecords         VendorPricing[]
  ratingSummary          VendorRating?
  reviews                VendorReview[]
  vehicles               VendorVehicle[]
  sourceApplication      VendorApplication?      @relation("VendorApplicationCreatedVendor")

  @@index([deletedAt])
  @@index([engagementMode])
}

enum VendorBusinessType {
  UNSPECIFIED
  INDIVIDUAL_OWNER_DRIVER
  SOLE_PROPRIETOR
  REGISTERED_BUSINESS
}

enum VendorEngagementMode {
  QUOTATION
  INSTANT_RATE
  HYBRID
}

model VendorServiceArea {
  id                     String             @id @default(cuid())
  vendorId               String
  scope                  VendorServiceScope
  originCity             String?
  originState            String?
  destinationCity        String?
  destinationState       String?
  serviceablePostalCodes String[]           @default([])
  active                 Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([scope])
  @@index([originCity])
  @@index([originState])
  @@index([destinationCity])
  @@index([destinationState])
  @@index([active])
}

model VendorServiceOffering {
  id          String            @id @default(cuid())
  vendorId    String
  serviceType VendorServiceType
  title       String
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, serviceType])
  @@index([vendorId])
  @@index([serviceType])
  @@index([active])
}

model VendorPricing {
  id                        String            @id @default(cuid())
  vendorId                  String
  serviceType               VendorServiceType
  pricingType               VendorPricingType
  basePrice                 Decimal?          @db.Decimal(12, 2)
  minimumPrice              Decimal?          @db.Decimal(12, 2)
  pricePerKilometre         Decimal?          @db.Decimal(12, 2)
  pricePerKilogram          Decimal?          @db.Decimal(12, 2)
  pricePerItem              Decimal?          @db.Decimal(12, 2)
  labourCharge              Decimal?          @db.Decimal(12, 2)
  packingCharge             Decimal?          @db.Decimal(12, 2)
  loadingCharge             Decimal?          @db.Decimal(12, 2)
  unloadingCharge           Decimal?          @db.Decimal(12, 2)
  insuranceChargePercentage Decimal?          @db.Decimal(5, 2)
  taxPercentage             Decimal?          @db.Decimal(5, 2)
  currency                  String            @default("INR")
  active                    Boolean           @default(true)
  effectiveFrom             DateTime?
  effectiveUntil            DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([serviceType])
  @@index([pricingType])
  @@index([active])
  @@index([effectiveFrom])
  @@index([effectiveUntil])
}

enum VendorServiceScope {
  WITHIN_CITY
  WITHIN_STATE
  PAN_INDIA
}

enum VendorServiceType {
  HOUSEHOLD_RELOCATION
  OFFICE_RELOCATION
  CORPORATE_RELOCATION
  VEHICLE_TRANSPORT
  COMMERCIAL_GOODS
  WAREHOUSING
  PACKING_ONLY
  LOADING_UNLOADING
  INSTALLATION_UNINSTALLATION
}

enum VendorPricingType {
  FIXED
  PER_KILOMETRE
  PER_ITEM
  PER_KILOGRAM
  CUSTOM_QUOTATION
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  referenceId        String          @unique
  leadId             String
  bookingId          String
  vendorId           String
  userId             String?
  transportationCost Decimal         @default(0) @db.Decimal(12, 2)
  packingCost        Decimal         @default(0) @db.Decimal(12, 2)
  unpackingCost      Decimal         @default(0) @db.Decimal(12, 2)
  labourCost         Decimal         @default(0) @db.Decimal(12, 2)
  insuranceCost      Decimal         @default(0) @db.Decimal(12, 2)
  otherCost          Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @db.Decimal(12, 2)
  currency           String          @default("INR")
  pickupDate         DateTime?
  deliveryDate       DateTime?
  transitDays        Int?
  status             QuotationStatus @default(SUBMITTED)
  validUntil         DateTime?
  pricingBreakdown   Json?
  termsJson          Json?
  inclusionsJson     Json?
  exclusionsJson     Json?
  remarks            String?
  internalRemarks    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  selectedForBooking Booking?        @relation("SelectedBookingQuotation")
  payments           Payment[]
  booking            Booking         @relation("BookingQuotations", fields: [bookingId], references: [id], onDelete: Cascade)
  lead               Lead            @relation(fields: [leadId], references: [id])
  user               User?           @relation(fields: [userId], references: [id])
  vendor             Vendor          @relation(fields: [vendorId], references: [id])

  @@index([quotationNumber])
  @@index([referenceId])
  @@index([leadId])
  @@index([bookingId])
  @@index([vendorId])
  @@index([userId])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
}

model InventoryItem {
  id              String    @id @default(cuid())
  inventoryId     String
  category        String
  itemName        String
  quantity        Int       @default(1)
  fragile         Boolean   @default(false)
  requiresPacking Boolean   @default(true)
  remarks         String?
  createdAt       DateTime  @default(now())
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model InventoryPhoto {
  id          String    @id @default(cuid())
  inventoryId String
  imageUrl    String
  roomType    String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model Inventory {
  id                         String           @id @default(cuid())
  referenceId                String           @unique
  leadId                     String           @unique
  status                     String           @default("DRAFT")
  completionPercentage       Int              @default(0)
  moveReadinessScore         Int              @default(0)
  createdBy                  String?
  remarks                    String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  additionalServices         Json?
  packingType                String?          @default("STANDARD")
  specialHandling            Json?
  preMoveServices            Json?
  callbackRequested          Boolean          @default(false)
  callbackSlot               String?
  destinationFloor           Int?
  destinationLiftAvailable   Boolean          @default(false)
  destinationParkingDistance String?
  destinationPropertyType    String?
  destinationSame            Boolean          @default(true)
  dismantlingServices        Json?
  installationServices       Json?
  packingServices            Json?
  photoInventoryRequested    Boolean          @default(false)
  photoInventoryUrls         Json?
  pickupFloor                Int?
  pickupLiftAvailable        Boolean          @default(false)
  pickupParkingDistance      String?
  pickupPropertyType         String?
  postMoveServices           Json?
  surveyType                 String?          @default("MANUAL")
  lead                       Lead             @relation(fields: [leadId], references: [id])
  items                      InventoryItem[]
  photos                     InventoryPhoto[]
}

model DestinationDetails {
  id                   String   @id @default(cuid())
  referenceId          String   @unique
  propertyType         String?
  floorNumber          Int?
  liftAvailable        Boolean?
  parkingDistance      String?
  installationServices Json?
  additionalServices   Json?
  specialInstructions  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Booking {
  id                   String               @id @default(cuid())
  bookingNumber        String               @unique
  leadId               String
  leadReferenceId      String
  userId               String?
  customerName         String
  customerMobile       String
  customerEmail        String?
  serviceType          String
  moveType             String
  moveDate             DateTime
  deliveryDate         DateTime?
  pickupCity           String
  pickupState          String
  pickupPincode        String
  pickupDigipin        String?
  pickupLatitude       Decimal?             @db.Decimal(10, 7)
  pickupLongitude      Decimal?             @db.Decimal(10, 7)
  dropCity             String
  dropState            String
  dropPincode          String
  dropDigipin          String?
  dropLatitude         Decimal?             @db.Decimal(10, 7)
  dropLongitude        Decimal?             @db.Decimal(10, 7)
  pickupAddress        String
  dropAddress          String
  contactJson          Json
  pickupAddressJson    Json
  dropAddressJson      Json
  scheduleJson         Json
  inventoryJson        Json
  inventorySummaryJson Json
  servicesJson         Json
  requirementsJson     Json?
  aiAnalysisJson       Json?
  vendorId             String?
  vendorName           String?
  assignedVendorCode   String?
  vendorJson           Json?
  selectedQuotationId  String?              @unique
  quotationJson        Json?
  paymentJson          Json?
  trackingJson         Json?
  timelineJson         Json
  auditJson            Json
  totalAmount          Decimal              @default(0) @db.Decimal(12, 2)
  currency             String               @default("INR")
  bookingStatus        String               @default("DRAFT")
  paymentStatus        String               @default("PENDING")
  trackingStatus       TrackingStatus       @default(NOT_STARTED)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lead                 Lead                 @relation(fields: [leadId], references: [id])
  selectedQuotation    Quotation?           @relation("SelectedBookingQuotation", fields: [selectedQuotationId], references: [id])
  user                 User?                @relation(fields: [userId], references: [id])
  assignedVendor       Vendor?              @relation("AssignedVendorBookings", fields: [vendorId], references: [id])
  bookingTrackings     BookingTracking[]
  payments             Payment?
  paymentBookingSyncs  PaymentBookingSync[]
  quotations           Quotation[]          @relation("BookingQuotations")

  @@index([bookingNumber])
  @@index([leadId])
  @@index([leadReferenceId])
  @@index([userId])
  @@index([vendorId])
  @@index([selectedQuotationId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([trackingStatus])
  @@index([customerMobile])
  @@index([moveDate])
  @@index([serviceType])
  @@index([moveType])
  @@index([pickupCity])
  @@index([pickupState])
  @@index([pickupPincode])
  @@index([pickupDigipin])
  @@index([dropCity])
  @@index([dropState])
  @@index([dropPincode])
  @@index([dropDigipin])
  @@index([createdAt])
}

model CallbackRequest {
  id                  String             @id @default(cuid())
  fullName            String
  mobile              String
  email               String?
  city                String?
  serviceType         String?
  preferredTime       String?
  message             String?
  status              String             @default("Pending")
  assignedTo          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  userId              String?
  vendorApplicationId String?
  User                User?              @relation(fields: [userId], references: [id])
  vendorApplication   VendorApplication? @relation(fields: [vendorApplicationId], references: [id], onDelete: SetNull)

  @@index([mobile])
  @@index([status])
  @@index([vendorApplicationId])
}

model VendorApplication {
  id                String                  @id @default(cuid())
  referenceId       String                  @unique
  requestId         String                  @unique @db.Uuid
  companyName       String
  businessType      VendorBusinessType
  engagementMode    VendorEngagementMode    @default(QUOTATION)
  operatingCategory String
  gstNumber         String?
  panNumber         String?
  contactName       String
  mobile            String
  email             String
  addressLine1      String
  city              String
  state             String
  postalCode        String
  status            VendorApplicationStatus @default(PENDING)
  consentAt         DateTime
  vendorId          String?                 @unique
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNotes       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  callbackRequests  CallbackRequest[]
  vendor            Vendor?                 @relation("VendorApplicationCreatedVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  reviewedByUser    User?                   @relation("VendorApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([mobile])
  @@index([email])
  @@index([panNumber])
  @@index([gstNumber])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([createdAt])
  @@index([engagementMode])
}

enum VendorApplicationStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id                         String                  @id @default(cuid())
  supabaseAuthId             String?                 @unique @db.Uuid
  email                      String?                 @unique
  mobile                     String                  @unique
  passwordHash               String
  fullName                   String
  role                       UserRole                @default(CUSTOMER)
  avatar                     String?
  isActive                   Boolean                 @default(true)
  emailVerified              Boolean                 @default(false)
  mobileVerified             Boolean                 @default(false)
  lastLogin                  DateTime?
  officeInvitedAt            DateTime?
  officeInvitationAcceptedAt DateTime?
  officePasswordSetAt        DateTime?
  officeFirstLoginAt         DateTime?
  officeLastLogoutAt         DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  vendorId                   String?
  bookings                   Booking[]
  callbackRequests           CallbackRequest[]
  Corporate                  Corporate?
  Customer                   Customer?
  customerDocuments          CustomerDocument[]
  Franchise                  Franchise?
  leads                      Lead[]
  Notification               Notification[]
  notificationPreference     NotificationPreference?
  payments                   Payment[]
  quotations                 Quotation[]
  vendor                     Vendor?                 @relation(fields: [vendorId], references: [id])
  reviewedVendorApplications VendorApplication[]     @relation("VendorApplicationReviewer")
  crmRoleAssignments         UserCrmRole[]           @relation("CrmRoleAssignedUser")
  crmAuditLogs               CrmAuditLog[]           @relation("CrmAuditActor")

  @@index([mobile])
  @@index([email])
  @@index([role])
}

model CrmRole {
  id          String              @id
  code        String              @unique
  name        String
  description String?
  isSystem    Boolean             @default(false)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  permissions CrmRolePermission[]
  assignments UserCrmRole[]

  @@index([isActive])
}

model CrmPermission {
  id          String              @id
  code        String              @unique
  module      String
  name        String
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  roles       CrmRolePermission[]

  @@index([module])
  @@index([isActive])
}

model CrmRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime      @default(now())
  role         CrmRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   CrmPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserCrmRole {
  id               String    @id
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedByUserId  String?
  user             User      @relation("CrmRoleAssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  role             CrmRole   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model CrmAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("CrmAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ServiceLocation {
  id                       String                         @id @default(cuid())
  code                     String                         @unique
  city                     String
  district                 String?
  state                    String
  countryCode              String                         @default("IN")
  stateCode                String?
  verificationPostalCode   String?
  locationSource           ServiceLocationSource          @default(MANUAL_REVIEW)
  locationVerifiedAt       DateTime?
  locationVerifiedByUserId String?
  serviceablePostalCodes   String[]                       @default([])
  status                   ServiceLocationStatus          @default(DRAFT)
  operationsContactName    String?
  operationsContactMobile  String?
  operationsContactEmail   String?
  plannedLaunchAt          DateTime?
  createdByUserId          String?
  approvedByUserId         String?
  approvedAt               DateTime?
  activatedByUserId        String?
  activatedAt              DateTime?
  suspendedByUserId        String?
  suspendedAt              DateTime?
  suspensionReason         String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  services                 ServiceLocationService[]
  statusHistory            ServiceLocationStatusHistory[]

  @@unique([city, state, countryCode])
  @@index([status])
  @@index([state])
  @@index([plannedLaunchAt])
}

model ServiceLocationService {
  id                      String                @id @default(cuid())
  serviceLocationId       String
  scope                   VendorServiceScope
  serviceType             VendorServiceType
  fulfilmentMode          ServiceFulfilmentMode
  status                  LocationServiceStatus @default(DRAFT)
  instantPricingAvailable Boolean               @default(false)
  surveyRequired          Boolean               @default(false)
  minimumVerifiedVendors  Int                   @default(1)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  serviceLocation         ServiceLocation       @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)

  @@unique([serviceLocationId, scope, serviceType])
  @@index([status])
  @@index([scope, serviceType])
}

model ServiceLocationStatusHistory {
  id                String                 @id @default(cuid())
  serviceLocationId String
  fromStatus        ServiceLocationStatus?
  toStatus          ServiceLocationStatus
  changedByUserId   String?
  reason            String?
  createdAt         DateTime               @default(now())
  serviceLocation   ServiceLocation        @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)

  @@index([serviceLocationId, createdAt])
  @@index([changedByUserId])
}

enum ServiceLocationStatus {
  DRAFT
  READY
  ACTIVE
  SUSPENDED
}

enum ServiceLocationSource {
  CATALOG
  POSTAL_LOOKUP
  MANUAL_REVIEW
}

enum LocationServiceStatus {
  DRAFT
  READY
  ACTIVE
  SUSPENDED
}

enum ServiceFulfilmentMode {
  INSTANT_RATE
  QUOTATION
  SURVEY_AND_QUOTATION
}

model Customer {
  id              String    @id @default(cuid())
  userId          String    @unique
  alternateMobile String?
  dateOfBirth     DateTime?
  gender          String?
  companyName     String?
  gstNumber       String?
  panNumber       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
}

model Corporate {
  id                 String    @id @default(cuid())
  userId             String    @unique
  companyName        String
  legalName          String?
  registrationNumber String?
  gstNumber          String?
  panNumber          String?
  contactPerson      String
  designation        String?
  alternateMobile    String?
  landline           String?
  website            String?
  email              String?
  industry           String?
  employeeStrength   Int?
  annualRelocations  Int?
  billingAddress     String?
  city               String?
  state              String?
  pincode            String?
  country            String?   @default("India")
  accountManager     String?
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  creditLimit        Decimal?  @db.Decimal(12, 2)
  paymentTerms       Int?      @default(30)
  preferredVendorId  String?
  isActive           Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
  @@index([gstNumber])
  @@index([city])
  @@index([state])
}

model Franchise {
  id                String    @id @default(cuid())
  userId            String    @unique
  franchiseCode     String    @unique
  franchiseName     String
  ownerName         String
  businessName      String?
  gstNumber         String?
  panNumber         String?
  aadhaarNumber     String?
  email             String?
  mobile            String
  alternateMobile   String?
  landline          String?
  website           String?
  address           String
  city              String
  district          String?
  state             String
  pincode           String
  country           String    @default("India")
  operatingArea     String?
  territory         String?
  latitude          Float?
  longitude         Float?
  joiningDate       DateTime?
  agreementExpiry   DateTime?
  commissionPercent Decimal?  @db.Decimal(5, 2)
  securityDeposit   Decimal?  @db.Decimal(12, 2)
  monthlyTarget     Int?
  yearlyTarget      Int?
  achievedBookings  Int       @default(0)
  rating            Float?    @default(0)
  totalRevenue      Decimal?  @db.Decimal(14, 2)
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  branchName        String?
  isActive          Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([franchiseCode])
  @@index([city])
